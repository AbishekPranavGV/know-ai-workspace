# KNOW AKS — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/knowaks
# Neon (free): get from neon.tech
DATABASE_URL="postgresql://postgres:password@localhost:5432/knowaks"

# ─── NextAuth / Auth.js ──────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-auth-secret-here"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── Email (Resend free tier — 100 emails/day) ───────────────────────────────
# Get from: https://resend.com
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@yourdomain.com"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="KNOW AKS"

# ─── Encryption (for OAuth token storage) ────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"

# ─── MFA ─────────────────────────────────────────────────────────────────────
MFA_ISSUER="KNOW AKS"
